{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Start Backend (3000)",
            "program": "${workspaceFolder}/backend/server.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Open Frontend (3000)",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "Run Full App",
            "configurations": [
                "Start Backend (3000)",
                "Open Frontend (3000)"
            ]
        }
    ]
}
